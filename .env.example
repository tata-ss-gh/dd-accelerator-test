# Copy to .env (git-ignored). Read by scripts/start-services.ps1 and docker-compose.yml.
DD_SITE=datadoghq.com
DD_ENV=lab
# Browser RUM: Datadog > Digital Experience > RUM application. Public by design (ships to browsers).
DD_RUM_APP_ID=
DD_RUM_CLIENT_TOKEN=
# Only for docker-compose.yml (the Agent container). Never commit a real key.
DD_API_KEY=
